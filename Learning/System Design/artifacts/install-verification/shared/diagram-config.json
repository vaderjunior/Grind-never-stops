{
  "startOnLoad": false,
  "securityLevel": "strict",
  "theme": "base",
  "look": "classic",
  "htmlLabels": false,
  "fontFamily": "Arial, sans-serif",
  "fontSize": 16,
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#e5ecdf",
    "primaryTextColor": "#153b35",
    "primaryBorderColor": "#5b8070",
    "lineColor": "#587367",
    "secondaryColor": "#edf0ef",
    "tertiaryColor": "#faf8f2"
  },
  "flowchart": {
    "wrappingWidth": 180,
    "nodeSpacing": 32,
    "rankSpacing": 48,
    "padding": 16,
    "diagramPadding": 16,
    "curve": "linear"
  },
  "sequence": {
    "wrap": true,
    "actorFontSize": 16,
    "messageFontSize": 16,
    "noteFontSize": 16
  }
}
